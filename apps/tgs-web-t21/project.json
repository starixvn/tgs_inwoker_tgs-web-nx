{
  "name": "tgs-web-t21",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tgs-web-t21/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/tgs-web-t21"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "tgs-web-t21:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "tgs-web-t21:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "tgs-web-t21:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "tgs-web-t21:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "tgs-web-t21:build:development"
        },
        "production": {
          "buildTarget": "tgs-web-t21:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/tgs-web-t21"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/tgs-web-t21/**/*.{ts,tsx,js,jsx}"]
      }
    }
    // "docker-build": {
    //   "executor": "nx:run-commands",
    //   "defaultConfiguration": "production",
    //   "options": {
    //     "commands": [],
    //     "parallel": false
    //   },
    //   "configurations": {
    //     "production": {
    //       "DockerContainerRegistry": "pgtgs/",
    //       "AppPath": "./apps/tgs-web-t21",
    //       "ImageName": "tgs-web-t21"
    //     }
    //   }
    // }
  },
  "tags": []
}
